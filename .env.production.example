# ============================================================
#  CotaTrans · modèle de .env pour la PRODUCTION
#  1. Copie ce fichier en « .env » sur le serveur
#  2. Remplis les valeurs entre < >
#  3. Lance : php artisan key:generate   (une seule fois)
#  Ne partage JAMAIS ce fichier rempli (ni sur GitHub, ni en capture).
# ============================================================
APP_NAME="CotaTrans"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<ton-domaine>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base MySQL fournie par l'hébergeur
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nom_de_la_base>
DB_USERNAME=<utilisateur>
DB_PASSWORD=<mot_de_passe_base>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=cotatrans_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Paiement Wave Business (le montant de chaque réservation est ajouté automatiquement)
WAVE_LINK=https://pay.wave.com/m/M_ci_0S9vrDPL2ExV/c/ci/

# Code de vérification par e-mail (inscription + connexion sur un nouvel appareil)
CODE_CONNEXION=true
APPAREIL_CONFIANCE_JOURS=30

# E-mails : « failover » = boîte LWS d'abord (1200/jour), puis Brevo si la boîte LWS refuse.
# Pour n'utiliser que Brevo : MAIL_MAILER=smtp
MAIL_MAILER=failover
MAIL_FAILOVER=lws,smtp

# Boîte e-mail LWS du domaine (paramètres SMTP affichés dans LWS > Administration e-mail)
LWS_MAIL_HOST=mail.<ton-domaine>
LWS_MAIL_PORT=465
LWS_MAIL_SCHEME=smtps
LWS_MAIL_USERNAME=contact@<ton-domaine>
LWS_MAIL_PASSWORD=<mot-de-passe-de-la-boite>

# SMTP Brevo (secours)
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<login-smtp>
MAIL_PASSWORD=<cle-smtp>
MAIL_FROM_ADDRESS="contact@<ton-domaine>"
MAIL_FROM_NAME="CotaTrans"
MAIL_EN_FILE=false
